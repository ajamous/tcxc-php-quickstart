{
    "name": "tcxc/php-quickstart",
    "description": "Enterprise-grade PHP SDK for TelecomsXChange (TCXC) Voice API",
    "type": "library",
    "license": "MIT",
    "keywords": ["tcxc", "telecom", "voip", "voice", "api", "sdk"],
    "authors": [
        {
            "name": "TCXC Team"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.5",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.3",
        "symfony/validator": "^6.2",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.15",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "TCXC\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TCXC\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "analyse": "phpstan analyse src tests --level=8",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "quality": [
            "@cs:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
